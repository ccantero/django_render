# Django
db.sqlite3

# Optional build timestamp written by `python manage.py stamp_build`.
# It is not a source file. Render can create it during the build.
build_info.json

# collectstatic output (STATIC_ROOT). WhiteNoise serves this directory in
# production after the Render build runs collectstatic. Do not commit it.
staticfiles/

# Older Django admin assets and a ManifestStaticFilesStorage manifest that
# were copied into the source tree. django.contrib.admin supplies admin
# assets at collectstatic time. Project source stays in static/core,
# static/currencyconverter, static/profile, and static/favicon.ico.
static/admin/
static/staticfiles.json

# Local environment files
.env
.env.*
django_render/.env
django_render/.env_local
django_render/.env_supabase
django_render/.env_supabase_old

